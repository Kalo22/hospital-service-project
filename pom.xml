<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.microintegrator.projects</groupId>
  <artifactId>HospitalServiceAPI</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>HospitalServiceAPI</name>
  <description>Integration project for Choreo deployment</description>

  <repositories>
    <repository>
      <id>wso2-nexus</id>
      <url>https://maven.wso2.org/nexus/content/groups/wso2-public/</url>
    </repository>
  </repositories>

  <build>
    <plugins>

      <!-- API Plugin -->
      <plugin>
        <groupId>org.wso2.maven</groupId>
        <artifactId>wso2-esb-api-plugin</artifactId>
        <version>2.1.0</version>
        <executions>
          <execution>
            <id>api</id>
            <phase>package</phase>
            <goals><goal>api</goal></goals>
            <configuration>
              <artifactLocation>src/main/resources/synapse-config/api</artifactLocation>
              <typeList>synapse/api</typeList>
              <serverRole>EnterpriseServiceBus</serverRole>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Endpoint Plugin -->
      <plugin>
        <groupId>org.wso2.maven</groupId>
        <artifactId>wso2-esb-endpoint-plugin</artifactId>
        <version>2.1.0</version>
        <executions>
          <execution>
            <id>endpoint</id>
            <phase>package</phase>
            <goals><goal>endpoint</goal></goals>
            <configuration>
              <artifactLocation>src/main/resources/synapse-config/endpoints</artifactLocation>
              <typeList>synapse/endpoint</typeList>
              <serverRole>EnterpriseServiceBus</serverRole>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Sequence Plugin -->
      <plugin>
        <groupId>org.wso2.maven</groupId>
        <artifactId>wso2-esb-sequence-plugin</artifactId>
        <version>2.1.0</version>
        <executions>
          <execution>
            <id>sequence</id>
            <phase>package</phase>
            <goals><goal>sequence</goal></goals>
            <configuration>
              <artifactLocation>src/main/resources/synapse-config/sequences</artifactLocation>
              <typeList>synapse/sequence</typeList>
              <serverRole>EnterpriseServiceBus</serverRole>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Registry Plugin (for JSON schemas) -->
      <plugin>
        <groupId>org.wso2.maven</groupId>
        <artifactId>wso2-general-project-plugin</artifactId>
        <version>2.1.0</version>
        <executions>
          <execution>
            <id>registry</id>
            <phase>package</phase>
            <goals><goal>registry</goal></goals>
            <configuration>
              <artifactLocation>src/main/resources/registry</artifactLocation>
              <typeList>registry/resource</typeList>
              <serverRole>EnterpriseServiceBus</serverRole>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>